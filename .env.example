# VerifyVision is local-only. Browser origins must be explicit.
VERIFYVISION_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Keep projects and generated training artifacts on the project/data drive.
# VERIFYVISION_DATA_DIR=D:/VerifyVision-data/projects

# Real LocateAnything-3B inference: NVIDIA CUDA on Windows or Linux only.
# VERIFYVISION_LOCATEANYTHING_WORKER_PATH=D:/VerifyVision/.vendor/Eagle/Embodied/locateanything_worker.py
VERIFYVISION_LOCATEANYTHING_MODEL=nvidia/LocateAnything-3B
VERIFYVISION_LOCATEANYTHING_REVISION=c32291ca5e996f5a7a485845b4f57a233936bba0
VERIFYVISION_LOCATEANYTHING_DEVICE=auto
VERIFYVISION_LOCATEANYTHING_DTYPE=auto
VERIFYVISION_LOCATEANYTHING_GENERATION_MODE=hybrid
VERIFYVISION_LOCATEANYTHING_MAX_NEW_TOKENS=8192

# Non-blocking, informational registry check. It never installs updates.
VERIFYVISION_DEPENDENCY_UPDATE_CHECK=true
VERIFYVISION_DEPENDENCY_UPDATE_INTERVAL_HOURS=24
# VERIFYVISION_DEPENDENCY_UPDATE_CACHE=D:/VerifyVision-data/cache/dependency-update-status.json
